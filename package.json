{
  "name": "fruitbiz",
  "version": "1.3.8",
  "description": "Local offline business document system",
  "author": {
    "name": "Suphasin",
    "email": "support@localbiz.app"
  },
  "homepage": "https://github.com/suphasin01/fruit",
  "repository": {
    "type": "git",
    "url": "https://github.com/suphasin01/fruit.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "health-check": "tsx src/health-check/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "axios": "^1.7.9",
    "form-data": "^4.0.5",
    "playwright": "^1.50.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.localbiz.app",
    "productName": "FruitBiz",
    "copyright": "Copyright © 2026 FruitBiz",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "web/**/*",
      "node_modules/**/*",
      "!node_modules/electron${/*}",
      "!node_modules/electron-builder${/*}",
      "!node_modules/typescript${/*}",
      "!node_modules/@types${/*}",
      "!src/**/*",
      "!**/*.ts",
      "!**/*.map"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "publish": {
      "provider": "github",
      "owner": "suphasin01",
      "repo": "fruit",
      "releaseType": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dmg"
        }
      ],
      "category": "public.app-category.business",
      "darkModeSupport": true,
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FruitBiz",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "menuCategory": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "dmg": {
      "title": "FruitBiz",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
